# ============================================================================
# LzgPaw — environment variables
#
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit a file containing real secrets. Only this file (.env.example),
# with placeholders, belongs in git.
#
# In production (Vercel), set these under:
#   Project Settings → Environment Variables
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server-side only. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never import in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://lzgpaw.com
NEXT_PUBLIC_SITE_NAME=LzgPaw
SUPPORT_EMAIL=Ricopack0117@gmail.com

# --- Admin auth ---------------------------------------------------------
# Admin sessions are handled entirely by Supabase Auth's own HttpOnly
# session cookies (see lib/supabase/server.ts) — no separate session secret
# is needed here.
#
# The FIRST admin account is created by running `npm run create-admin`
# (see scripts/create-admin.ts) — never by a hardcoded password in code.

# --- Admin bootstrap (ONE-TIME USE — see scripts/create-admin.ts) ----------
# Set these only while running `npm run create-admin`, then delete them from
# your .env.local. They are read by that script alone; the running app never
# reads them, so leaving them here permanently only adds unnecessary exposure.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# --- PayPesa Merchant API ------------------------------------------------
# SECRET — server-side only. See services/payments/PayPesaProvider.ts for the
# exact integration point. Do not guess or hardcode endpoint URLs here;
# fill these in from your PayPesa merchant dashboard / official docs.
PAYPESA_API_KEY=
PAYPESA_SECRET=
PAYPESA_MERCHANT_ID=
PAYPESA_API_BASE_URL=
PAYPESA_WEBHOOK_SECRET=
PAYPESA_ENV=sandbox

# --- Rate limiting -----------------------------------------------------
# Admin-login brute-force protection is implemented directly against
# Postgres (the `admin_login_attempts` table — see lib/auth.ts) rather than
# a separate service, so no additional env vars are needed for it. If you
# later add an edge-level rate limiter (e.g. Upstash Redis) in front of
# other public API routes, its credentials would go here.
